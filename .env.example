# `make up` copies this to .env if .env is missing. .env is gitignored; put secrets there only.
DATABASE_URL=postgresql://controlfinder:controlfinder@localhost:5433/controlfinder
# A Cursor user API key (Cursor Dashboard > Integrations). The generator and the judge run on it.
CURSOR_API_KEY=
# Optional: OpenAI embeddings stretch row.
OPENAI_API_KEY=
